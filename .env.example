# ============================================================
# Lucky Birr – Environment Variables
# Copy this file to .env and fill in the values.
# Lines marked [REQUIRED] must be set for the app to function.
# Lines marked [optional] can be omitted locally.
# NEVER commit .env with real secrets.
# ============================================================

# Server
NODE_ENV=production          # optional – defaults to development
PORT=10000                   # optional – defaults to 10000

# Public URL of this deployment (used for CORS)
# [REQUIRED in production]
WEBSITE_URL=https://lucky-birr.onrender.com

# JWT signing secret – min 32 random characters
# [REQUIRED]
JWT_SECRET=replace-with-a-random-secret-at-least-32-chars

# Comma-separated list of admin email addresses
# [optional – no admin panel without this]
ADMIN_EMAILS=admin@example.com

# Supabase – [REQUIRED for database features]
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_BUCKET=screenshots  # optional – defaults to "screenshots"

# Telegram outbound notifications – [optional]
# Set both to enable admin notifications on new submissions.
TELEGRAM_BOT_TOKEN=
ADMIN_CHAT_ID=

# Chapa payment gateway – [REQUIRED for deposit/withdrawal]
# Register at https://dashboard.chapa.co and get your live secret key
CHAPA_SECRET_KEY=CHASECK_TEST-replace-with-your-live-key

# Chapa webhook secret – [optional but recommended]
# Set this in Chapa dashboard under Webhooks; also set it on the server to verify callbacks
CHAPA_WEBHOOK_SECRET=replace-with-random-webhook-secret
# The webhook/callback URL to register in the Chapa dashboard is:
#   <WEBSITE_URL>/api/deposits/callback
# The browser return URL is derived from WEBSITE_URL and is validated
# server-side, so it can never be redirected to an external host.

# Telegram inbound webhook – [optional]
# Set to enable the /webhook/:secret endpoint.
# Must be different from TELEGRAM_BOT_TOKEN.
TELEGRAM_WEBHOOK_SECRET=

# Wallet limits – [optional]
# Amounts are in ETB and are enforced server-side on every deposit and
# withdrawal request. Values must be positive numbers; invalid values fall
# back to the defaults shown below.
DEPOSIT_MIN_ETB=10
DEPOSIT_MAX_ETB=50000
WITHDRAW_MIN_ETB=50
WITHDRAW_MAX_ETB=25000

# Fast Keno round timings – [optional]
# Milliseconds spent in each phase of a live round. The full cycle is the sum
# of the three. Shorten them in a sandbox for a faster feedback loop; keep the
# betting window comfortably long in production.
FAST_KENO_BETTING_MS=20000
FAST_KENO_DRAWING_MS=6000
FAST_KENO_RESULT_MS=6000

# Game engine – [optional]
# Target theoretical RTP (Return To Player) for Keno/Fast Keno/Higher-Lower/
# Aviator, as
# a fraction in (0,1). Defaults to 0.95 (5% house edge) if unset or invalid.
# Changing this changes the house edge globally for all players — never set
# per-player or at request time.
TARGET_RTP=0.95
